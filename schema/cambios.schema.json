{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dias": {
      "type": "number",
      "const": 90
    },
    "cambios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "ambito": {
            "type": "string",
            "enum": [
              "zona",
              "municipio"
            ]
          },
          "tipo": {
            "type": "string",
            "enum": [
              "alta",
              "baja",
              "cambio"
            ]
          },
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "campos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detalle": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "fecha",
          "ambito",
          "tipo",
          "id",
          "nombre",
          "campos",
          "detalle"
        ]
      }
    }
  },
  "required": [
    "dias",
    "cambios"
  ],
  "$id": "https://datos.atlaszbe.es/v1/cambios.schema.json",
  "title": "Atlas ZBE · cambios.json"
}
